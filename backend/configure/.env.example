# Copier ce fichier en .env (dans le même dossier) puis remplir les valeurs.
#
# Compte qui envoie les emails de rendez-vous.
# En local on peut laisser vide : les emails s'affichent alors dans le terminal du serveur.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Adresse d'expéditeur. La plupart des serveurs refusent une adresse différente
# de EMAIL_HOST_USER (erreur 553 "Sender address rejected").
DEFAULT_FROM_EMAIL=AGSP <adresse@exemple.com>

# Serveur SMTP. Sans ces lignes : Gmail (smtp.gmail.com, SSL sur le port 465),
# qui demande un mot de passe d'application de 16 caractères.
# Exemple avec le serveur de l'école :
# EMAIL_HOST=mail.estim-ecole.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
